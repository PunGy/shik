let os shell.os
let arch shell.arch

let platform $ match "{os}-{arch}" {
  :Darwin-arm64 :macos-aarch64
  :Darwin-x86_64 :macos-x86_64
  :Linux-x86_64 :macos-x86_64
  :Linux-aarch64 :linux-aarch64
  #pl pl
}

let system $ match "{os}-{arch}" {
  :macos-aarch64 :Darwin-arm64
  :macos-x86_64 :Darwin-x86_64
  :macos-x86_64 :Linux-x86_64
  :linux-aarch64 :Linux-aarch64
  _ "unknown"
}

print "your platform is {platform}"
print "your system is {system}"

let values [ 1 2 3 4 ]

print $ match values {
  :name :string
  [x y] :wrong
  [x y #rest] "position {x} {y}, rest: {rest}"
}

print $ match 0 {
  1 :no
  2 :no
  _ :wildcard
}


